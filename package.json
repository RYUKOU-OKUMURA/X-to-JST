{
  "name": "x-to-jst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/chrome-smoke.mjs",
    "test:chrome": "node scripts/chrome-smoke.mjs --extension",
    "test:jev": "node scripts/jev-live.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chrono-node": "^2.10.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
